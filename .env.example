# ── Backend ───────────────────────────────────────────────────
# Neon serverless PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Random string for JWT signing (generate: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_secret

# ── AI providers (backend only, never exposed to the browser) ─
# Primary LLM provider (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# HuggingFace token (image gen + LLM fallback)
HF_TOKEN=hf_...

# Override default models (optional)
CHAT_MODEL=
IMAGE_MODEL=

# ── Optional hardening overrides ──────────────────────────────
# Comma-separated CORS allowlist (default: production + Capacitor + local dev)
CORS_ORIGINS=
# Number of trusted reverse proxies in front of the backend (default 2)
TRUST_PROXY_HOPS=
